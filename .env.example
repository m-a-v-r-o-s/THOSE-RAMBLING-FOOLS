# --- /admin panel (cookie session, login at /admin/login) ---
# The band manager logs in with these when opening /admin.
ADMIN_USER=changeme
ADMIN_PASSWORD=change-this-to-a-long-secret

# --- Gig storage ---
# Where the gigs JSON file is written. In production on Railway, attach a Volume
# and set this to its mount path (e.g. /data) so gigs survive redeploys/restarts.
# Leave unset locally to use ./data/gigs.json.
# GIGS_DATA_DIR=/data

# --- Site URL ---
# Used for canonical/OG links, robots.txt and sitemap.xml. Defaults to the real
# production domain (https://www.thoseramblingfools.com), so this only needs
# setting to point a preview deployment at its own host. Read at build time.
# SITE_URL=https://www.thoseramblingfools.com

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID. Leave unset to keep analytics off entirely.
# The cookie banner gates loading: it only fires after a visitor accepts. Read at build time.
# NEEDS USER INPUT: a real GA4 measurement ID, if you want analytics.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
