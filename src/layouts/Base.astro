---
import { ClientRouter } from 'astro:transitions';
import CookieBanner from '../components/CookieBanner';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';
import { ALBUMS, MULE_LINKS, SINGLES } from '../albums';
import '../styles/globals.css';

interface Props {
  // Page title, rendered as "<title> | Those Rambling Fools". Omit for the home page.
  title?: string;
  description?: string;
  // Open Graph / Twitter card. Omitted fields fall back to the site defaults.
  og?: { title?: string; description?: string; image?: string };
  noindex?: boolean;
  canonical?: boolean;
  admin?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  og = {},
  noindex = false,
  canonical = true,
  admin = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: Original Music from Kos, Greece`;
// Same shape Next emitted: no trailing slash on the home URL.
const pageUrl = `${SITE_URL}${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const ogUrl = og.title ? pageUrl : SITE_URL;
const ogTitle = og.title ?? SITE_NAME;
const ogDescription = og.description ?? SITE_DESCRIPTION;
const ogImage = `${SITE_URL}${og.image ?? '/covers/finafinallbg.webp'}`;

// Band entity schema. Members and origin come from data/story.json and the gig
// listings, the profile links from the homepage footer, the discography from
// the same ALBUMS array the turntable renders.
const BAND_SCHEMA = {
  '@type': 'MusicGroup',
  '@id': `${SITE_URL}/#band`,
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  image: `${SITE_URL}/covers/finafinallbg.webp`,
  logo: `${SITE_URL}/covers/newlogo.webp`,
  genre: 'Rock',
  foundingLocation: { '@type': 'Place', name: 'Kos, Greece' },
  areaServed: { '@type': 'Place', name: 'Kos, Greece' },
  member: [
    { '@type': 'Person', name: 'Christos P.' },
    { '@type': 'Person', name: 'Ioannis Vrettakos' },
  ],
  album: ALBUMS.map((a) => ({
    '@type': 'MusicAlbum',
    name: a.title,
    image: `${SITE_URL}${a.cover}`,
    byArtist: { '@id': `${SITE_URL}/#band` },
  })),
  sameAs: [
    'https://open.spotify.com/artist/04c4MB7bgg1DwEV7kLLJvf',
    'https://www.youtube.com/@ThoseRamblingFools',
    'https://www.instagram.com/thoseramblingfoolsofficial/',
    'https://www.deezer.com/en/artist/334497151',
  ],
};

// Christos P.'s solo project, whose singles play on the same turntable.
const MULE_SCHEMA = {
  '@type': 'MusicGroup',
  '@id': `${SITE_URL}/#mule`,
  name: 'Mule',
  description: 'Solo project of Christos P. of Those Rambling Fools.',
  member: [{ '@type': 'Person', name: 'Christos P.' }],
  track: SINGLES.map((s) => ({
    '@type': 'MusicRecording',
    name: s.title,
    image: `${SITE_URL}${s.cover}`,
    byArtist: { '@id': `${SITE_URL}/#mule` },
  })),
  sameAs: [MULE_LINKS.instagram, MULE_LINKS.youtube],
};
const SCHEMA = { '@context': 'https://schema.org', '@graph': [BAND_SCHEMA, MULE_SCHEMA] };
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@300..900&family=IBM+Plex+Mono:wght@400;500&family=Josefin+Sans:wght@300;400&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    {/* Preload critical above-the-fold images */}
    <link rel="preload" as="image" href="/covers/newlogo.webp" />
    <link rel="preload" as="image" href="/covers/playeronlynew.webp" />
    {/* The opening title plays once per tab. ClientRouter swaps <html>'s
        attributes on every navigation, so the flag is re-applied after each swap. */}
    <script is:inline>
      try {
        const seen = () => document.documentElement.classList.add('no-intro');
        if (sessionStorage.getItem('trf-intro')) seen();
        else sessionStorage.setItem('trf-intro', '1');
        document.addEventListener('astro:after-swap', seen);
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={pageUrl} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/covers/favicon.ico" />
    {/* Page swaps without a reload, so the album keeps playing across pages
        (see components/AudioProvider.tsx). No animation, same as the old site. */}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <script type="application/ld+json" set:html={JSON.stringify(SCHEMA)} />
    <slot />
    {!admin && <CookieBanner client:idle />}
  </body>
</html>
